# Copy to Apps/Api_Php/.env. Real process environment variables win over this file.

APP_ENV=development
APP_URL=http://localhost:5173

# SQLite database and runtime storage (empty = defaults inside Apps/Api_Php/storage)
DB_PATH=
STORAGE_PATH=

# Seed logins. There are no built-in passwords:
# ADMIN_PASSWORD is required (12+ characters), DEMO_PASSWORD is optional (12+ characters).
ADMIN_EMAIL=admin@catalog-demo.local
ADMIN_PASSWORD=
DEMO_PASSWORD=

# JWT signing keys (required in production, long random strings)
JWT_SECRET=
JWT_REFRESH_SECRET=

# Order requests are e-mailed here
ORDER_EMAIL=orders@catalog-demo.example

# Mail: "log" writes to storage/mail.log, "smtp" sends through PHPMailer
MAIL_DRIVER=log
MAIL_HOST=
MAIL_PORT=465
MAIL_SECURE=ssl
MAIL_USER=
MAIL_PASS=
MAIL_FROM=no-reply@catalog-demo.example
MAIL_FROM_NAME=Demo Parts

# "on" (default) or "off": login / password-reset rate limits
RATE_LIMIT=on

# InPost ShipX (optional; shipments are disabled when the token is empty)
INPOST_API_URL=
INPOST_API_TOKEN=
INPOST_ORG_ID=
INPOST_GEOWIDGET_TOKEN=
INPOST_COURIER_SENDING_METHOD=dispatch_order
