{
  "name": "@catalog/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "deploy:upload": "tsx --env-file-if-exists=../../.env.deploy --env-file-if-exists=.env.deploy scripts/Deploy.ts",
    "deploy": "npm run build && npm run deploy:upload",
    "deploy:dry": "cross-env DEPLOY_DRY_RUN=true npm run deploy",
    "products:push": "tsx --env-file-if-exists=../../.env.deploy --env-file-if-exists=.env.deploy scripts/Products_Push.ts",
    "products:push:dry": "cross-env DEPLOY_DRY_RUN=true npm run products:push",
    "env:push": "tsx --env-file-if-exists=../../.env.deploy --env-file-if-exists=.env.deploy scripts/Env_Push.ts",
    "env:push:dry": "cross-env DEPLOY_DRY_RUN=true npm run env:push"
  },
  "dependencies": {
    "@catalog/shared": "*",
    "@fontsource/inter": "^5.1.0",
    "@fontsource/saira-condensed": "^5.1.0",
    "@mantine/core": "^7.13.0",
    "@mantine/form": "^7.13.0",
    "@mantine/hooks": "^7.13.0",
    "@mantine/modals": "^7.13.0",
    "@mantine/notifications": "^7.13.0",
    "@tanstack/react-query": "^5.59.0",
    "lucide-react": "^0.544.0",
    "ofetch": "^1.4.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-error-boundary": "^4.1.0",
    "react-router-dom": "^7.8.2",
    "zod": "^3.23.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@vitejs/plugin-react": "^5.0.0",
    "basic-ftp": "^6.0.1",
    "cross-env": "^10.1.0",
    "jsdom": "^25.0.0",
    "postcss": "^8.4.0",
    "postcss-preset-mantine": "^1.17.0",
    "postcss-simple-vars": "^7.0.1",
    "ssh2-sftp-client": "^12.1.1",
    "tsx": "^4.19.0",
    "vite": "^7.1.2",
    "vitest": "^5.0.3"
  }
}
